# Keys for wallexbot. Copy this file to ../.env (the folder above this repo: config.py reads
# ROOT.parent / ".env"), or set the same names as environment variables, which take precedence.
# Backtests, the offline tests and `python -m wallexbot shadow --no-ai` need none of them.

# AI: BoxAPI is the main provider; OpenAI is the optional fallback (same model, used only if BoxAPI fails)
BOXAPI_KEY=
OPENAI_API_KEY=

# Wallex: only for `live` and the read-only `check`. Live mode refuses to start unless the key was
# created on the hackathon trade-credit account and marked so here: WALLEX_KEY_ACCOUNT=hackathon
WALLEX_API_KEY=
WALLEX_KEY_ACCOUNT=main
# optional, read only by `python -m wallexbot check`; live orders send the API key alone
WALLEX_SUBACCOUNT_ID=
