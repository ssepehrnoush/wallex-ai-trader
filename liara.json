{
  "app": "wallex-ai-trader-live",
  "platform": "docker",
  "port": 8000,
  "healthCheck": {
    "command": "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)\"",
    "interval": 30,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 15
  }
}
